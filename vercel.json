{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "functions": {
    "api/proxy.mjs": { "maxDuration": 30 }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?upstream=/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "/api/proxy?upstream=/images/:path*"
    },
    {
      "source": "/generated/:path*",
      "destination": "/api/proxy?upstream=/generated/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
